---
// The "Heat Included · Water Included · Private Basement" band.
import { site } from '../lib/site';

const icons: Record<number, string> = {
  // Simple line icons: flame, droplet, lock
  0: 'M12 3c1.5 3.2 5 5.6 5 10a5 5 0 0 1-10 0c0-2.2 1-3.6 2-4.8.3 1.6 1.2 2.6 2.2 3 .2-3.2.8-5.8.8-8.2Z',
  1: 'M12 3.5s-6 6.4-6 10.5a6 6 0 0 0 12 0c0-4.1-6-10.5-6-10.5Z',
  2: 'M6.5 11h11v9h-11z M9 11V8a3 3 0 0 1 6 0v3 M12 14.5v2',
};
---
<section class="section section--navy included" aria-labelledby="included-heading">
  <div class="container">
    <h2 id="included-heading" class="visually-hidden">Included with every apartment</h2>
    <ul class="included__list">
      {site.included_highlights.map((item: { title: string; text: string }, i: number) => (
        <li class="included__item" data-reveal style={`transition-delay: ${i * 120}ms`}>
          <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true">
            <path d={icons[i] ?? icons[0]} fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
          </svg>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .included { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .included__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    text-align: center;
  }
  .included__item svg { width: 2.75rem; height: 2.75rem; color: var(--sand); margin: 0 auto 1rem; }
  .included__item h3 { font-size: var(--step-3); margin-bottom: 0.4rem; }
  .included__item p { color: rgba(250, 247, 240, 0.8); margin-inline: auto; max-width: 22ch; }
  @media (min-width: 48rem) {
    .included__item + .included__item { border-left: 1px solid rgba(217, 204, 180, 0.3); }
  }
</style>

---
// "Contact & Tours" band used at the bottom of most pages.
import { site, href, telLink, mailLink } from '../lib/site';
---
<section class="section section--navy contact-panel" aria-labelledby="contact-panel-heading">
  <div class="narrow center" data-reveal>
    <span class="eyebrow">Contact &amp; Tours</span>
    <h2 id="contact-panel-heading">Come see Casa Grande</h2>
    <p class="lede">{site.contact.showing_note}</p>
    <p class="contact-panel__lines">
      <a href={telLink}>{site.contact.phone}</a>
      <span aria-hidden="true">·</span>
      <a href={mailLink}>{site.contact.email}</a>
    </p>
    <div class="btn-row">
      <a class="btn btn--light" href={telLink}>Call</a>
      <a class="btn btn--ghost-light" href={href('/contact/')}>Contact Details</a>
    </div>
  </div>
</section>

<style>
  .contact-panel__lines {
    font-family: var(--font-serif); font-size: var(--step-2);
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1rem; margin-block: 1.5rem 2rem;
  }
  .contact-panel__lines a { text-decoration: none; overflow-wrap: anywhere; }
  .contact-panel__lines a:hover { text-decoration: underline; }
  .contact-panel__lines span { color: var(--sand); }
</style>

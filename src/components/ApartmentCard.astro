---
// Preview card for one apartment type (used on the homepage).
import PhotoFrame from './PhotoFrame.astro';
import Value from './Value.astro';
import { href, formatRent } from '../lib/site';
import { photo } from '../lib/images';

interface Props { apt: any }
const { apt } = Astro.props;
const image = photo(apt.photos?.[0]);
const rent = formatRent(apt.rent);
---
<article class="apt-card" data-reveal>
  <a href={href(`/apartments/#${apt.id}`)} class="apt-card__media" tabindex="-1" aria-hidden="true">
    <PhotoFrame image={image} alt="" label={`${apt.name} photo`} ratio="4 / 3" />
  </a>
  <div class="apt-card__body">
    <span class="eyebrow">{apt.bedrooms} Bedroom{apt.bedrooms > 1 ? 's' : ''}</span>
    <h3><a href={href(`/apartments/#${apt.id}`)}>{apt.name}</a></h3>
    <dl class="apt-card__facts">
      <div>
        <dt>Rent</dt>
        <dd>
          <Value value={rent} label="Rent" fallback="Call for pricing" unconfirmed={!apt.rent_confirmed}>{rent}<span class="per"> / month</span></Value>
        </dd>
      </div>
      <div>
        <dt>Size</dt>
        <dd><Value value={apt.square_feet} label="Sq ft">{apt.square_feet} sq ft</Value></dd>
      </div>
      <div>
        <dt>Availability</dt>
        <dd><Value value={apt.availability} label="Availability" fallback="Call for availability" /></dd>
      </div>
    </dl>
    <p class="apt-card__note">Heat and water included</p>
    <a class="text-link" href={href(`/apartments/#${apt.id}`)}>View apartment<span class="visually-hidden">: {apt.name}</span></a>
  </div>
</article>

<style>
  .apt-card { background: var(--ivory); display: flex; flex-direction: column; }
  .apt-card__media { display: block; overflow: hidden; }
  .apt-card__media :global(img) { transition: transform 1.2s var(--ease); }
  .apt-card:hover .apt-card__media :global(img) { transform: scale(1.03); }
  .apt-card__body { padding: 1.75rem clamp(1.25rem, 3vw, 2rem) 2rem; }
  .apt-card h3 { font-size: var(--step-3); margin-bottom: 1.25rem; }
  .apt-card h3 a { text-decoration: none; }
  .apt-card__facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 0.5rem 2rem; margin: 0 0 1rem; }
  .apt-card__facts dt { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--taupe); }
  .apt-card__facts dd { margin: 0.15rem 0 0; font-family: var(--font-serif); font-size: var(--step-1); color: var(--navy); }
  .per { font-family: var(--font-sans); font-size: 0.875rem; color: var(--taupe); }
  .apt-card__note { font-size: 0.9375rem; color: var(--taupe); margin-bottom: 1.5rem; }
  @media (max-width: 30rem) { .apt-card__facts { grid-template-columns: 1fr 1fr; } }
</style>
